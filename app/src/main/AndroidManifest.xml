<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions at all: fully offline app. -->

    <application
        android:name=".SnippetsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Snippets">

        <!-- Launcher activity: must be exported so the launcher can start it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Editor: exported to receive share intents and static shortcut. -->
        <activity
            android:name=".EditorActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
            </intent-filter>
        </activity>

        <!-- Trash (recycle bin) activity. -->
        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Transparent activity that only writes the clipboard and finishes. -->
        <activity
            android:name=".CopyNoteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Snippets.Transparent" />

        <!-- Same trampoline pattern for template widgets. -->
        <activity
            android:name=".FillTemplateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Snippets.Transparent" />

        <!-- Widget configuration activity. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.SnippetsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/snippet_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TemplateWidgetProvider"
            android:exported="true"
            android:label="@string/template_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/template_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TemplateCopyWidgetProvider"
            android:exported="true"
            android:label="@string/template_copy_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/template_copy_widget_info" />
        </receiver>

    </application>

</manifest>
