<?xml version="1.0" encoding="utf-8"?>
<!-- Template widget: same structure as widget_snippet, but visually marked
     with the slot glyph so fill widgets are distinguishable on the home
     screen. RemoteViews-compatible views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="@string/format_slot"
        android:textColor="@color/widget_text"
        android:textStyle="bold"
        android:textSize="14sp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
