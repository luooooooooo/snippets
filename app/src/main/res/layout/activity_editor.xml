<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ===== 顶部导航栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_undo"
            android:contentDescription="@string/format_undo" />

        <ImageButton
            android:id="@+id/btn_redo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_redo"
            android:contentDescription="@string/format_redo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/more" />

        <TextView
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/done"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <!-- ===== 元信息行 ===== -->
    <TextView
        android:id="@+id/meta_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- ===== 标题 ===== -->
    <EditText
        android:id="@+id/edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:background="@null"
        android:hint="@string/title_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textSize="24sp"
        android:textStyle="bold"
        android:importantForAutofill="no" />

    <!-- ===== 标签行 ===== -->
    <LinearLayout
        android:id="@+id/tag_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/tag_click_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/edit_tags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:singleLine="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tag_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_tags"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_tags"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:paddingStart="4dp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!-- ===== 编辑区 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/edit_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <EditText
            android:id="@+id/edit_source"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:background="@null"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:typeface="monospace"
            android:textSize="13sp"
            android:visibility="gone"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edit_markdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:background="@null"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:typeface="monospace"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"
            android:hint="@string/markdown_hint"
            android:importantForAutofill="no" />

        <WebView
            android:id="@+id/markdown_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ===== 底部固定工具栏 ===== -->
    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:elevation="8dp">

        <TextView
            android:id="@+id/button_mode_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/markdown_mode"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btn_task"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_checklist"
            android:contentDescription="@string/task_list" />

        <TextView
            android:id="@+id/btn_format_panel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/format_panel"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/button_format_inline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/auto_format"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ===== 格式面板（底部弹出，默认隐藏） ===== -->
    <LinearLayout
        android:id="@+id/format_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- 标题级别 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fmt_h1"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="H1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/fmt_h2"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="H2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/fmt_h3"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="H3"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/fmt_body"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/format_body"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/fmt_quote"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/format_quote"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/fmt_code_block"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/format_code"
                    android:textSize="14sp"
                    android:typeface="monospace" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 行内格式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/fmt_bold"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/fmt_italic"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="I"
                android:textSize="16sp"
                android:textStyle="italic" />

            <Button
                android:id="@+id/fmt_strike"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="S"
                android:textSize="16sp" />

            <Button
                android:id="@+id/fmt_underline"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="U"
                android:textSize="16sp" />

            <Button
                android:id="@+id/fmt_highlight"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/format_highlight"
                android:textSize="12sp"
                android:textColor="@color/format_highlight_button" />

            <Button
                android:id="@+id/fmt_color"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/format_color"
                android:textSize="12sp"
                android:textColor="@color/format_color_button" />

        </LinearLayout>

        <!-- 列表与对齐 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/fmt_ol"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/format_numbers"
                android:textSize="14sp" />

            <Button
                android:id="@+id/fmt_link"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/format_link"
                android:textSize="14sp" />

            <Button
                android:id="@+id/fmt_align_left"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/format_align_left"
                android:textSize="14sp" />

            <Button
                android:id="@+id/fmt_align_center"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/format_align_center"
                android:textSize="14sp" />

            <Button
                android:id="@+id/fmt_align_right"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/format_align_right"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
