<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <EditText
        android:id="@+id/edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@null"
        android:hint="@string/title_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:importantForAutofill="no" />

    <!-- 标签栏：显示该笔记已选标签，点击进入多选/新建对话框。 -->
    <LinearLayout
        android:id="@+id/tag_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/edit_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tag_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/add_tags"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_tags"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/format_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/button_bold"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_bold"
                android:textStyle="bold"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_italic"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_italic"
                android:textStyle="italic"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_underline"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_underline"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_strike"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_strike"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_color"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_color"
                android:textColor="@color/format_color_button"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_highlight"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_highlight"
                android:textColor="@color/format_highlight_button"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_bullets"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_bullets"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_numbers"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_numbers"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_link"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_link"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_undo"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_undo"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_redo"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_redo"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_slot"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="@string/format_slot"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/fill_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/fill_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/fill_hint"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/button_fill_apply"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fill_apply" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <WebView
        android:id="@+id/edit_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <EditText
        android:id="@+id/edit_source"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:background="@null"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:typeface="monospace"
        android:textSize="13sp"
        android:visibility="gone"
        android:importantForAutofill="no" />

</LinearLayout>
