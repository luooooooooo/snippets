<?xml version="1.0" encoding="utf-8"?>
<!-- Copy-template widget: copy icon + slot glyph so it is distinguishable
     from both the plain snippet widget (icon only) and the fill widget
     (glyph only). RemoteViews-compatible views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_copy"
        android:tint="@color/widget_text"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/format_slot"
        android:textColor="@color/widget_text"
        android:textStyle="bold"
        android:textSize="14sp"
        android:importantForAccessibility="no" />

</LinearLayout>
